FROM node:22-alpine AS frontend-build

WORKDIR /app/hexora-frontend
COPY hexora-frontend/package*.json ./
RUN npm ci
COPY hexora-frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY hexora-backend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-build /app/hexora-frontend/dist /usr/share/nginx/html
EXPOSE 80
